@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager
<link href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css" rel="stylesheet">


<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CNMA consultapp</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/aspproject.styles.css" asp-append-version="true" />
</head>
<body>
    @if (ViewData["HideSidebar"] as bool? != true)
    {
        <header>
            <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                
                    <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                        <img src="~/images/logocnma.png" alt="CNMA Logo" style="height: 40px; margin-right: 10px;" />
                        <span>CNMA -consult app-</span>
                    </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                       
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    }


    @if (ViewData["HideSidebar"] as bool? != true)
    
    {
       <div class="sidebar">
        <div class="container-fluid">
            <div class="row">
            
                <!-- Sidebar -->
                <nav class="col-md-2 d-none d-md-block bg-light sidebar p-3" style="min-height: 100vh;">
                    <div class="sidebar-sticky">
                        <h5 class="text-primary">Menu</h5>
                        <ul class="nav flex-column">
                        <!-- Admin-only links -->
                            <li class="nav-item">
                                    <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Dashboard</a>
                            </li>
                            <li class="nav-item">
                                
                                    <a class="nav-link" asp-area="" asp-controller="detail_contrat" asp-action="Index">
                                         Contrats
                                    </a>
                            </li>
                           
                            <li class="nav-item">
                                
                                    <a class="nav-link" asp-area="" asp-controller="detail_sinistre" asp-action="Index">
                                        Sinistres
                                    </a>
                            </li>
                           
                                @if (User.Identity.IsAuthenticated && await UserManager.IsInRoleAsync(
                               await UserManager.GetUserAsync(User), "Admin")){
                                
                                    <li class="nav-item">
                                        <a class="nav-link" asp-area="Admin" asp-controller="Users" asp-action="Index">Users</a>
                                    </li>
                               }    
                            @*     } *@
                            @* } *@

                        </ul>
                    </div>
                </nav>

                <!-- Main content -->
                <main role="main" class="col-md-10 ml-sm-auto px-4 py-4">
                    @RenderBody()
            </main>
            
        </div>
    </div>
    </div>}
   
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
