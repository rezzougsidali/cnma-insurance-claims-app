@model aspproject.Models.EditUserViewModel
@{
    var roles = (IEnumerable<Microsoft.AspNetCore.Identity.IdentityRole>)ViewBag.AllRoles;
}
<div class="edit-roles-wrapper">
<h2>Edit Roles for @Model.Email</h2>

<form asp-action="Edit" method="post">
    <input type="hidden" name="Id" value="@Model.Id" />
    <div>
        @foreach (var role in roles)
        {
            <div>
                <input type="checkbox" name="selectedRoles" value="@role.Name"
                @(Model.Roles.Contains(role.Name) ? "checked" : "") />
                @role.Name
            </div>
        }
    </div>
        <button type="submit" class="btn-save">Save</button>
        <div class="goback">
            <a asp-action="Index" class="back-link">← Back to List</a>
        </div>

</form>
</div>
<style>
    .edit-roles-wrapper {
        max-width: 600px;
        margin: 30px auto;
        padding: 30px;
        background-color: #fdfdfd;
        border-radius: 12px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
    }

        .edit-roles-wrapper h2 {
            text-align: center;
            margin-bottom: 25px;
            color: #2c3e50;
            font-weight: 600;
        }

    .roles-list {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 12px;
        margin-bottom: 25px;
    }

        .roles-list div {
            padding: 10px;
            border: 1px solid #e0e0e0;
            border-radius: 8px;
            background-color: #fafafa;
        }

        .roles-list input[type="checkbox"] {
            margin-right: 8px;
        }

    .btn-save {
        display: block;
        width: 100%;
        padding: 10px;
        font-weight: 600;
        border-radius: 6px;
        background-color: #0d6efd;
        color: white;
        border: none;
        transition: background-color 0.2s ease;
    }

        .btn-save:hover {
            background-color: #0b5ed7;
        }

    .goback {
        margin-top: 20px;
        text-align: left;
    }

    .back-link {
        display: inline-block;
        background-color: #0d6efd;
        color: white;
        padding: 10px 18px;
        text-decoration: none;
        border-radius: 25px;
        font-weight: 600;
        transition: background-color 0.3s ease;
    }

        .back-link:hover {
            background-color: #0b5ed7;
            text-decoration: none;
        }

</style>


